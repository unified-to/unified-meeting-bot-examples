# Copy to .env, fill in, then load it into your shell before running any example:
#   set -a; source .env; set +a
# SETUP.md explains where each value comes from.

# Unified API key: app.unified.to → Settings → API Keys
UNIFIED_API_KEY=

# Unified workspace secret, used to verify webhook signatures: same page as the API key
UNIFIED_WORKSPACE_SECRET=

# A connection to a meeting-bot integration: zoommeetingbot, microsoftteamsmeetingbot,
# webexmeetingbot or googlemeetmeetingbot (SETUP.md step 3, or app.unified.to → Connections)
UNIFIED_CONNECTION_ID=

# Public HTTPS URL that forwards to this machine, so Unified can deliver webhooks.
# e.g. `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`
PUBLIC_URL=

# Optional: local port for the webhook listener (default 3000)
# PORT=3000

# Optional: API region (default https://api.unified.to)
#   EU: https://api-eu.unified.to   AU: https://api-au.unified.to
# UNIFIED_API_URL=https://api.unified.to
